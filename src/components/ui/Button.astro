---
// Reusable button component with three visual variants.
// Renders an <a> when `href` is provided, otherwise a <button>.
// Caller classes are merged with the base classes via the class:list
// directive on the root element, keeping the variant class always applied.
interface Props {
  /** Visual style: 'primary' (default), 'secondary' or 'ghost'. */
  variant?: 'primary' | 'secondary' | 'ghost';
  /** When provided, the button renders as an anchor link. */
  href?: string;
  /** Native button type; only used when no `href` is given. */
  type?: 'button' | 'submit';
  /** Additional classes from the caller. */
  class?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
} = Astro.props;
---

{
  href ? (
    <a href={href} class:list={[`btn btn-${variant}`, className]}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[`btn btn-${variant}`, className]}>
      <slot />
    </button>
  )
}