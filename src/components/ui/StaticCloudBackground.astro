---
// StaticCloudBackground.astro — Lightweight, high-fidelity static cloud background.
// Recreates the organic watercolor cloud / stepped simplex noise contour aesthetic in pure SVG.
// Matches the exact AZ brand violet/lilac palette with zero JS, zero WebGL,
// zero CPU/GPU overhead, and instant load time across all devices.

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={['overflow-hidden pointer-events-none select-none', className]}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1440 540"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full block"
  >
    <defs>
      <!-- Base sky gradient -->
      <linearGradient id="az-sky-base" x1="10%" y1="5%" x2="90%" y2="95%">
        <stop offset="0%" stop-color="#7B6BAF" />
        <stop offset="35%" stop-color="#6E5D9F" />
        <stop offset="70%" stop-color="#5B4A8B" />
        <stop offset="100%" stop-color="#463673" />
      </linearGradient>

      <!-- Soft corner vignette -->
      <radialGradient id="az-vignette" cx="50%" cy="45%" r="65%">
        <stop offset="65%" stop-color="#000000" stop-opacity="0" />
        <stop offset="90%" stop-color="#281A4F" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#1B1038" stop-opacity="0.5" />
      </radialGradient>

      <!-- Cloud gradients for contours -->
      <linearGradient id="az-cloud-grad-l" x1="15%" y1="10%" x2="80%" y2="90%">
        <stop offset="0%" stop-color="#B8A7E8" stop-opacity="0.55" />
        <stop offset="50%" stop-color="#917FC7" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#685698" stop-opacity="0.1" />
      </linearGradient>

      <linearGradient id="az-cloud-grad-r" x1="85%" y1="15%" x2="20%" y2="85%">
        <stop offset="0%" stop-color="#CBBDF2" stop-opacity="0.5" />
        <stop offset="45%" stop-color="#9B8BD0" stop-opacity="0.32" />
        <stop offset="100%" stop-color="#5E4E8E" stop-opacity="0.08" />
      </linearGradient>

      <radialGradient id="az-puff-ambient" cx="40%" cy="40%" r="50%">
        <stop offset="0%" stop-color="#C2B2EE" stop-opacity="0.4" />
        <stop offset="60%" stop-color="#8877BA" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#5E4E8E" stop-opacity="0" />
      </radialGradient>

      <!-- Soft edge filters matching watercolor / simplex noise contours -->
      <filter id="az-contour-blur" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="8" />
      </filter>
      <filter id="az-cloud-wash" x="-15%" y="-15%" width="130%" height="130%">
        <feGaussianBlur stdDeviation="16" />
      </filter>
      <filter id="az-ambient-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="28" />
      </filter>
    </defs>

    <!-- Base Atmosphere -->
    <rect width="1440" height="540" fill="url(#az-sky-base)" />

    <!-- Ambient diffuse glow patches -->
    <g filter="url(#az-ambient-glow)" opacity="0.7">
      <ellipse cx="280" cy="180" rx="360" ry="200" fill="url(#az-puff-ambient)" />
      <ellipse cx="720" cy="140" rx="420" ry="160" fill="url(#az-cloud-grad-l)" />
      <ellipse cx="1200" cy="200" rx="380" ry="220" fill="url(#az-cloud-grad-r)" />
      <ellipse cx="1320" cy="360" rx="260" ry="180" fill="url(#az-puff-ambient)" />
    </g>

    <!-- Watercolor Cloud Wash Level 1 (Broad soft organic masses) -->
    <g filter="url(#az-cloud-wash)" opacity="0.6">
      <!-- Right mass broad contour -->
      <path
        d="M620,180 C740,110 880,90 1010,130 C1140,80 1280,100 1380,160 C1440,195 1490,260 1520,350 L1520,560 L620,560 Z"
        fill="url(#az-cloud-grad-r)"
      />
      <!-- Left mass broad contour -->
      <path
        d="M-60,200 C60,130 180,140 280,180 C380,125 500,140 580,210 C650,270 710,340 760,440 L760,560 L-60,560 Z"
        fill="url(#az-cloud-grad-l)"
      />
    </g>

    <!-- Watercolor Cloud Wash Level 2 (Defined organic contours matching reference) -->
    <g filter="url(#az-contour-blur)" opacity="0.7">
      <!-- Right cloud bank prominent lobe 1 -->
      <path
        d="M780,240 C860,175 970,165 1060,205 C1130,150 1240,155 1320,200 C1380,165 1450,185 1500,230 L1500,480 C1420,440 1340,460 1260,420 C1160,370 1060,400 960,350 C880,310 820,320 780,240 Z"
        fill="#8E7DC4"
        opacity="0.45"
      />

      <!-- Right cloud bank inner lobe 2 (higher elevation wisp) -->
      <path
        d="M980,180 C1050,125 1150,120 1230,160 C1290,125 1370,135 1430,175 C1470,205 1490,250 1500,310 L1500,240 C1460,180 1390,160 1320,135 C1240,105 1140,110 1060,140 C1010,160 970,195 980,180 Z"
        fill="#A695DC"
        opacity="0.42"
      />

      <!-- Right cloud bank highlight crest -->
      <path
        d="M1120,150 C1180,105 1270,110 1330,145 C1380,120 1440,130 1480,165 C1460,140 1410,120 1350,110 C1280,95 1200,100 1130,130 C1100,145 1090,160 1120,150 Z"
        fill="#C4B4F0"
        opacity="0.38"
      />

      <!-- Left cloud bank prominent lobe 1 -->
      <path
        d="M-40,240 C40,170 140,165 220,205 C300,155 410,165 480,225 C540,185 620,205 670,265 L670,440 C600,390 510,410 430,370 C330,320 230,345 140,305 C60,270 -10,310 -40,240 Z"
        fill="#8B7AC0"
        opacity="0.42"
      />

      <!-- Left cloud bank inner lobe 2 -->
      <path
        d="M60,190 C130,135 220,130 290,170 C350,135 430,145 490,190 C530,220 540,265 520,310 C460,260 380,240 310,215 C240,185 150,180 70,210 C50,195 40,185 60,190 Z"
        fill="#A493DA"
        opacity="0.38"
      />

      <!-- Left cloud bank highlight crest -->
      <path
        d="M160,155 C220,115 300,120 360,155 C410,130 460,140 500,170 C470,145 420,130 370,120 C310,105 230,110 170,138 C150,150 140,160 160,155 Z"
        fill="#C5B5F2"
        opacity="0.35"
      />
    </g>

    <!-- Center Soft Misty Wash behind Navbar -->
    <g filter="url(#az-cloud-wash)" opacity="0.5">
      <path
        d="M480,150 C580,100 700,95 810,135 C920,95 1030,110 1110,165 C1020,145 920,130 820,145 C710,165 600,140 480,150 Z"
        fill="#C6B6F2"
      />
      <ellipse cx="720" cy="110" rx="260" ry="70" fill="#DDD1FB" opacity="0.4" />
    </g>

    <!-- Fine Watercolor Wisps (creates that organic, non-uniform fluid cloud feeling) -->
    <g filter="url(#az-contour-blur)" opacity="0.35">
      <path
        d="M840,260 C920,215 1010,225 1080,260 C1150,220 1230,235 1290,280 C1210,260 1130,250 1050,275 C980,295 900,280 840,260 Z"
        fill="#D2C3F8"
      />
      <path
        d="M220,250 C290,210 380,220 440,260 C510,225 580,240 640,285 C570,265 490,250 420,275 C350,295 280,270 220,250 Z"
        fill="#C8B8F4"
      />
    </g>

    <!-- Bottom Depth & Corner Vignette -->
    <rect width="1440" height="540" fill="url(#az-vignette)" />
  </svg>
</div>
